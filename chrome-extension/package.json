{
  "name": "natural-tts-chrome-extension",
  "version": "1.5.1",
  "description": "Privacy-first TTS Chrome extension with local Metal-accelerated processing",
  "type": "module",
  "scripts": {
    "build": "tsc && bun run build.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:e2e": "bun run build && node tests/e2e/run-e2e.mjs",
    "type-check": "tsc --noEmit",
    "verify:permissions": "node scripts/verify-permissions.cjs dist",
    "package": "node scripts/package.mjs"
  },
  "keywords": [
    "chrome-extension",
    "text-to-speech",
    "tts",
    "privacy",
    "mlx",
    "metal"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@types/bun": "^1.3.0",
    "@types/chrome": "0.3.0",
    "happy-dom": "20.14.5",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3"
  },
  "dependencies": {}
}
