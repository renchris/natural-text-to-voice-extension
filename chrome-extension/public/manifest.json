{
  "manifest_version": 3,
  "name": "Natural Text-to-Speech",
  "version": "1.5.0",
  "description": "Privacy-first TTS with local Metal-accelerated processing",
  "minimum_chrome_version": "148",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "offscreen",
    "tts"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "speak-selection": {
      "description": "Speak the selected text"
    },
    "stop-speaking": {
      "description": "Stop speaking"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
